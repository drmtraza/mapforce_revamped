# Local development defaults. Copy to `.env`. Every value here is a placeholder that
# matches infra/compose/docker-compose.yml; none may be reused outside a developer machine.

# Host-port overrides for docker compose, if defaults clash with other local services.
# Export them in your shell (compose does not read this file); keep the URLs below in sync.
# POSTGRES_HOST_PORT=5432 REDIS_HOST_PORT=6379 TEMPORAL_HOST_PORT=7233 TEMPORAL_UI_HOST_PORT=8233
# S3_HOST_PORT=9000 S3_CONSOLE_HOST_PORT=9001 KEYCLOAK_HOST_PORT=8080

NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Migrations run as the schema owner; the API and relay use least-privilege roles (RLS enforced).
DATABASE_OWNER_URL=postgres://mapforce_owner:local-owner-pw@localhost:5432/mapforce
DATABASE_APP_URL=postgres://mapforce_app:local-app-pw@localhost:5432/mapforce
DATABASE_RELAY_URL=postgres://mapforce_relay:local-relay-pw@localhost:5432/mapforce
DATABASE_POOL_MAX=10

# Optional: shared rate-limit store. In-memory limits apply when unset.
REDIS_URL=redis://localhost:6379

# Generate a long random value for any non-local environment.
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

OIDC_ISSUER_URL=http://localhost:8080/realms/mapforce
OIDC_CLIENT_ID=mapforce-web
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_ALLOW_INSECURE_HTTP=true

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mapforce-evidence
S3_ACCESS_KEY_ID=local-s3-key
S3_SECRET_ACCESS_KEY=local-s3-secret
S3_FORCE_PATH_STYLE=true
EVIDENCE_URL_TTL_SECONDS=60

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-control
RESEARCH_PYTHON_TASK_QUEUE=research-python

TENANT_DAILY_RESEARCH_JOB_LIMIT=100
# Pages the company-site crawler may fetch per workspace per rolling 24 h (used + reserved).
TENANT_DAILY_CRAWL_PAGE_LIMIT=200
# Contact enrichment jobs per workspace per rolling 24 h.
TENANT_DAILY_ENRICH_LIMIT=50
# AES-256-GCM key material for contact values. Replace before any non-local use.
CONTACT_FIELD_KEY=dev-contact-field-key-not-for-production!
RATE_LIMIT_PER_MINUTE=300
FEATURE_MOCK_PROVIDERS=true

# Python research worker. The crawler still needs the global source flag and a
# workspace admin opt-in (Settings > Sources) before it is used.
FEATURE_COMPANY_SITE_CRAWLER=true
# Public page describing the crawler; sent in its User-Agent. Replace before deploying.
CRAWLER_INFO_URL=https://example.invalid/mapforce-bot
# Brave Search API key. Leave empty to keep live search off. An operator must also set
# source_registry.enabled for brave_search, and each workspace admin opts in.
BRAVE_SEARCH_API_KEY=
# Licensed contact provider. Leave off until D12 (terms + credentials) is approved.
FEATURE_LICENSED_CONTACTS=false
LICENSED_CONTACTS_API_KEY=

# Phase 4 AI. Mock is the default. Hermes stays off until URL + credentials exist.
TENANT_DAILY_AI_RUN_LIMIT=20
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=15000
FEATURE_HERMES=false
HERMES_BASE_URL=
HERMES_API_KEY=
