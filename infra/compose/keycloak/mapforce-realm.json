{
  "realm": "mapforce",
  "enabled": true,
  "displayName": "Mapforce (local development)",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "mapforce-web",
      "name": "Mapforce web (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/v1/auth/callback",
        "http://localhost:4000/api/v1/auth/callback"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@tenant-a.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Synthetic",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice-local-only", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@tenant-b.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Synthetic",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-local-only", "temporary": false }]
    }
  ]
}
