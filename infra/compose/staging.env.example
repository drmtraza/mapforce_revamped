# Staging-like overrides for a local dry run of the API/web against Compose infra.
# Copy selected lines into `.env` when practising a staging posture. Never reuse these
# placeholder tokens outside a developer machine.

NODE_ENV=production
COOKIE_SECURE=true
OIDC_ALLOW_INSECURE_HTTP=false
EXPOSE_OPENAPI=false
METRICS_TOKEN=replace-with-at-least-16-char-metrics-token
SYNTHETIC_PROBE_TOKEN=replace-with-at-least-16-char-probe-token
DEFAULT_TENANT_PLAN=beta
MAX_BETA_TENANTS=5
FEATURE_MOCK_PROVIDERS=true
FEATURE_LICENSED_CONTACTS=false
FEATURE_HERMES=false
